{
  "name": "tropelex-memory-viewer",
  "displayName": "Tropelex Memory Viewer",
  "description": "View and manage Tropelex project memory",
  "version": "0.0.1",
  "publisher": "tropelex",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/memory/*.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tropelex.openMemoryViewer",
        "title": "Open Memory Viewer",
        "category": "Tropelex"
      },
      {
        "command": "tropelex.refreshMemory",
        "title": "Refresh Memory",
        "category": "Tropelex"
      },
      {
        "command": "tropelex.scanFileForDecisions",
        "title": "Scan File for Decision References (Memory Lens)",
        "category": "Tropelex"
      },
      {
        "command": "tropelex.clearLensAnnotations",
        "title": "Clear Memory Lens Annotations",
        "category": "Tropelex"
      }
    ],
    "configuration": {
      "title": "Tropelex",
      "properties": {
        "tropelex.serverUrl": {
          "type": "string",
          "default": "http://localhost:8766",
          "description": "URL of the running Tropelex server, used by Memory Lens to scan files for decision references."
        },
        "tropelex.project": {
          "type": "string",
          "default": "",
          "description": "Tropelex project name to scan against. Defaults to the first workspace folder's name if left empty."
        },
        "tropelex.instanceSecret": {
          "type": "string",
          "default": "",
          "description": "TROPEL_EX_SECRET value from the Tropelex server's .env file (or its startup log, on first run). Required for scan requests once the server enforces instance auth; unlike the MCP server and OpenCode plugin, this extension doesn't share a process tree with the Tropelex install, so it can't read the .env file directly."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tropelex",
          "title": "Tropelex",
          "icon": "$(brain)"
        }
      ]
    },
    "views": {
      "tropelex": [
        {
          "id": "tropelexMemory",
          "name": "Project Memory",
          "icon": "$(list-unordered)",
          "contextualTitle": "Tropelex Memory"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "tropelex.scanFileForDecisions",
          "group": "tropelex",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
